---
import Layout from '../layouts/Layout.astro';

const title = '404: Page not found | One World';
const description = 'The page you are looking for does not exist or has been moved.';
---

<Layout path="/404" title={title} description={description}>
  <section class="mx-auto max-w-2xl px-4 sm:px-6 pt-40 pb-32 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-emerald-400">404</p>
    <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-slate-400">
      This corner of the world hasn't been generated yet: the page you are looking for does not exist, or it has been moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-md bg-emerald-500 px-6 py-3 text-sm font-medium text-slate-950 transition hover:bg-emerald-400"
      >Back to home</a
    >
  </section>
</Layout>
