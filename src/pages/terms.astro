---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';
import { type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url) as Lang;
const zh = lang === 'zh';
---

<Layout
  path="/terms"
  title={zh ? '服务条款 · One World' : 'Terms of Service · One World'}
  description={zh ? 'One World 服务条款：使用本站与本站内容的相关约定。' : 'One World Terms of Service: the agreement covering use of this site.'}
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-white">{zh ? '服务条款' : 'Terms of Service'}</h1>
    <p class="mt-2 text-sm text-slate-500">{zh ? '最后更新：2026 年 8 月 7 日' : 'Last updated: August 7, 2026'}</p>

    <div class="mt-8 space-y-8 text-sm leading-7 text-slate-400">
      <section>
        <h2 class="text-lg font-semibold text-slate-200">{zh ? '1. 接受条款' : '1. Acceptance'}</h2>
        <p class="mt-2">
          {zh
            ? '欢迎访问 One World（下称「本站」）。访问或使用本站即表示你同意受本条款约束；如不同意，请停止使用本站。'
            : 'Welcome to One World (the "Site"). By accessing or using the Site you agree to these terms; if you do not agree, please do not use the Site.'}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-200">{zh ? '2. 站点内容' : '2. Site Content'}</h2>
        <p class="mt-2">
          {zh
            ? '本站内容为产品介绍与说明，按「现状」提供，可能随产品迭代发生变化。我们努力保证信息准确，但不对内容的完整性、时效性作任何保证。'
            : 'Content is provided "as is" for product introduction purposes and may change over time. We strive for accuracy but make no warranties regarding completeness or timeliness.'}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-200">{zh ? '3. 知识产权' : '3. Intellectual Property'}</h2>
        <p class="mt-2">
          {zh
            ? '本站的文案、设计与标识归项目方所有，未经许可不得用于商业目的。涉及开源代码的部分以其仓库中声明的开源许可证为准。'
            : "The Site's copy, design, and branding belong to the project team and may not be used commercially without permission. Open-source code is governed by the license declared in its repository."}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-200">{zh ? '4. 责任限制' : '4. Limitation of Liability'}</h2>
        <p class="mt-2">
          {zh
            ? '在法律允许的最大范围内，本站不对因使用或无法使用本站内容而产生的任何间接、附带或后果性损失承担责任。'
            : 'To the maximum extent permitted by law, the Site is not liable for any indirect, incidental, or consequential damages arising from use of or inability to use its content.'}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-200">{zh ? '5. 条款变更与联系' : '5. Changes & Contact'}</h2>
        <p class="mt-2">
          {zh ? '本条款可能更新，变更将在本页发布。如有疑问，请通过 ' : 'These terms may be updated; changes will be posted here. Questions can be raised via '}
          <a href="https://github.com/bayernjf/one-world" class="text-emerald-400 hover:text-emerald-300">GitHub</a>
          {zh ? ' 仓库的 Issues 与我们联系。' : ' Issues.'}
        </p>
      </section>
    </div>
  </section>
</Layout>
