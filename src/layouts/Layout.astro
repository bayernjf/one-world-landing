---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  /** 页面路径（不含语言前缀），如 "/" */
  path: string;
  /** 自定义页面标题；缺省时使用站点默认标题 */
  title?: string;
  /** 自定义页面描述；缺省时使用 seo.description */
  description?: string;
}

const { path, title: titleProp, description: descriptionProp } = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const site = Astro.site?.href ?? 'https://one-world.bayjf.com';

const title = titleProp ?? `One World${lang === 'zh' ? ' · 生活游戏化引擎' : ' · Life Gamification Engine'}`;
const description = descriptionProp ?? t('seo.description');
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      lang={lang}
      title={title}
      description={description}
      keywords={t('seo.keywords')}
      path={path}
      site={site}
    />
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
