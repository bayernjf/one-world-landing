---
import { useTranslations } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import Icon from '@bay/landing-ui/components/Icon.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  { icon: 'Repeat', title: t('features.f1.title'), desc: t('features.f1.desc') },
  { icon: 'Target', title: t('features.f2.title'), desc: t('features.f2.desc') },
  { icon: 'Gamepad2', title: t('features.f3.title'), desc: t('features.f3.desc') },
  { icon: 'Code', title: t('features.f4.title'), desc: t('features.f4.desc') },
];
---

<section id="features" class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{t('features.title')}</h2>
      <p class="mt-4 text-slate-400">{t('features.subtitle')}</p>
    </div>
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((f) => (
        <div class="group p-6 rounded-2xl bg-white/[0.03] ring-1 ring-white/5 hover:ring-emerald-500/30 hover:bg-white/[0.05] transition">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-300 flex items-center justify-center">
            <Icon name={f.icon} size={20} />
          </div>
          <h3 class="mt-4 font-semibold text-lg">{f.title}</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
