---
import { useTranslations } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,0.15),transparent_50%)]"></div>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-300 ring-1 ring-emerald-500/20">
      {t('hero.badge')}
    </span>
    <h1 class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight bg-gradient-to-br from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
      {t('hero.title')}
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#play" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">
        {t('hero.cta.primary')}
      </a>
      <a href="https://github.com" target="_blank" rel="noopener" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-white/5 hover:bg-white/10 text-white font-medium ring-1 ring-white/10 transition">
        {t('hero.cta.secondary')}
      </a>
    </div>
  </div>
</section>
