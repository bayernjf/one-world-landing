---
import { useTranslations } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="play" class="py-20 sm:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl p-10 sm:p-16 text-center bg-gradient-to-br from-emerald-500/10 via-sky-500/10 to-transparent ring-1 ring-white/10">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.15),transparent_60%)]"></div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">{t('cta.title')}</h2>
      <p class="mt-4 text-slate-300 max-w-xl mx-auto">{t('cta.subtitle')}</p>
      <a href="https://github.com/bayernjf/one-world" target="_blank" rel="noopener" class="mt-8 inline-block px-8 py-3.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition">
        {t('cta.button')}
      </a>
    </div>
  </div>
</section>
