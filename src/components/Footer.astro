---
import { useTranslations, localizedPath } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="py-10 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
    <div class="flex items-center gap-2">
      <span class="inline-block w-4 h-4 rounded bg-gradient-to-br from-emerald-400 to-sky-500"></span>
      <span>One World · {t('footer.tagline')}</span>
    </div>
    <div class="flex items-center gap-5">
      <a href="https://github.com/bayernjf/one-world" target="_blank" rel="noopener noreferrer" class="text-slate-500 transition hover:text-slate-300">GitHub</a>
      <a href="https://bayjf.com" target="_blank" rel="noopener noreferrer" class="text-slate-500 transition hover:text-slate-300">BayJF</a>
      <a href={localizedPath('/privacy', lang)} class="text-slate-500 transition hover:text-slate-300">{t('footer.privacy')}</a>
      <a href={localizedPath('/terms', lang)} class="text-slate-500 transition hover:text-slate-300">{t('footer.terms')}</a>
    </div>
    <p>© {year} One World. {t('footer.rights')}</p>
  </div>
</footer>
